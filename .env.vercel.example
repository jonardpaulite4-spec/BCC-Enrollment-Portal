# Add these values in Vercel Project Settings > Environment Variables.
# NEVER commit real passwords or secrets to GitHub.

NODE_ENV=production
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=baaocc_portal
# Optional. Comma-separated exact frontend origins. Same-origin Vercel needs no CORS entry.
CORS_ORIGINS=https://your-project.vercel.app
